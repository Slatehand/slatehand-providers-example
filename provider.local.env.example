# 复制为 provider.local.env（Git 忽略）后按本机部署填写；Core 加载本 Provider 目录时由 bundle 读取。
# 同名进程环境变量优先。只在存在 var/secrets/windows-model-service-token 时接入 Windows 默认模型服务。

# Windows 模型服务地址（LAN 地址 + 端口）。
SLATEHAND_WINDOWS_RUNTIME_ENDPOINT=http://<windows-lan-ip>:8791
# 以下三项只供 scripts/windows_node.sh 经 SSH 启停 Windows 服务；Core 不使用。
SLATEHAND_WINDOWS_SSH_TARGET=<ssh-alias>
# Windows 上本仓库的位置。
SLATEHAND_WINDOWS_REPOSITORY_ROOT='<drive>:\path\to\slatehand-providers-example'
SLATEHAND_WINDOWS_LISTEN_ADDRESS=<windows-lan-ip>

# 可选：Colab 节点（H3、Breeze）。存在 var/secrets/colab-model-service-token 时接入（scripts/colab_node.sh up 会生成），
# Core 运行期间经 colab ssh 隧道把本机回环端口转发到 VM。
# SLATEHAND_COLAB_SESSION=slate
# SLATEHAND_COLAB_LOCAL_PORT=18791
# SLATEHAND_COLAB_CLI=/path/to/colab

# 可选：Breeze 地址（默认同 Windows 服务）、Mac 服务端口与开关、Whisper。
# SLATEHAND_BREEZE_ENDPOINT=http://<windows-lan-ip>:8791
# SLATEHAND_MAC_PROVIDER_PORT=8792
# SLATEHAND_AUTOSTART_MAC_PROVIDER=1
# SLATEHAND_WHISPER_ENDPOINT=http://127.0.0.1:8793
# SLATEHAND_WHISPER_SERVER=/opt/homebrew/bin/whisper-server
# SLATEHAND_WHISPER_MODEL=/path/to/ggml-large-v3-turbo-q5_0.bin
